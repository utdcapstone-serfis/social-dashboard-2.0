# Copy to .env.local for `vercel dev`, and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables for deployments.
# These are read ONLY by the serverless function in api/meta.ts and are never
# shipped to the browser (no VITE_ prefix on purpose).

META_GRAPH_VERSION=v23.0
META_IG_USER_ID=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# YouTube — read ONLY by api/youtube.ts (server side, no VITE_ prefix).
# Client ID/secret: Google Cloud -> APIs & Services -> Credentials (Web application,
# redirect URI https://developers.google.com/oauthplayground).
# Refresh token: OAuth Playground with scopes yt-analytics.readonly + youtube.readonly,
# authorized as the channel owner.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok - read ONLY by api/tiktok.ts (server side, no VITE_ prefix).
# Client key/secret: developers.tiktok.com -> Manage apps -> your app -> Sandbox
# (use the Sandbox credentials while the app is unaudited; the Serfis account
# must be added as a sandbox target user).
# Refresh token: run `npm run tiktok:auth`, authorize as the account owner, and
# the script writes TIKTOK_REFRESH_TOKEN into .env.local for you.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# Only needed if Login Kit accepted the redirect with a trailing slash.
# TIKTOK_REDIRECT_URI=https://serfis-site.vercel.app/tiktok/callback/

# X / Twitter - read ONLY by api/x.ts (server side, no VITE_ prefix).
# Bearer token: console.x.com -> your project -> app -> Keys and tokens -> Bearer Token.
# Access is pay-per-use with prepaid credits (there are no tiers any more). X bills
# per post read, so api/x.ts fetches at most 100 posts once an hour.
# User id: run `npm run x:id -- <handle>` and the script writes X_USER_ID for you.
X_BEARER_TOKEN=
X_USER_ID=
# Optional fallback: if X_USER_ID is empty the function resolves this handle once per instance.
X_USERNAME=

# Pinterest - read ONLY by api/pinterest.ts (server side, no VITE_ prefix).
# App ID/secret: developers.pinterest.com -> My apps -> your app (the app must be
# created from the Pinterest BUSINESS account you want to track; Trial access is enough).
# Register https://serfis-site.vercel.app/pinterest/callback under Configure -> Redirect URIs.
# Refresh token: run `npm run pinterest:auth`, authorize as the account owner, and
# the script writes PINTEREST_REFRESH_TOKEN into .env.local for you. Refresh tokens
# expire after 60 days: run `npm run pinterest:auth -- --refresh` before then.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REFRESH_TOKEN=
# Written by the auth script; lets the dashboard warn 14 days before the refresh token lapses.
PINTEREST_REFRESH_TOKEN_EXPIRES_AT=
# Only needed if the registered redirect URI differs from the default above.
# PINTEREST_REDIRECT_URI=https://serfis-site.vercel.app/pinterest/callback

# Bluesky - read ONLY by api/bluesky.ts (server side, no VITE_ prefix).
# The public AppView (public.api.bsky.app) needs no token: just the handle of the
# account to track, e.g. serfis.bsky.app (with or without the leading @).
BLUESKY_HANDLE=
